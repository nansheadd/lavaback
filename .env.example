# .env.example - Template for production environment variables
# Copy this file to .env locally or use it as a reference for your Railway variables.

# Database URL (Provided automatically by Railway if using a PostgreSQL plugin, or set manually)
# Format: postgresql://username:password@host:port/database
# Note: Fly.io `postgres://` format is mapped to `postgresql://` in database.py
DATABASE_URL=postgresql://user:password@localhost/dbname

# Comma-separated list of allowed origins for CORS (e.g. your Vercel frontend URL)
# Example: https://my-frontend.vercel.app,http://localhost:5173
CORS_ORIGINS=https://your-production-frontend.vercel.app

# Secret Key for JWT Authentication
# Generate a secure key using: openssl rand -hex 32
SECRET_KEY=your_super_secret_production_key_here
